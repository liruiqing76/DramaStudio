{
  "1": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "Wan2.2-I2V-A14B-HighNoise-Q4_K_M.gguf",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sdpa"
    }
  },
  "2": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "Wan2.2-I2V-A14B-LowNoise-Q4_K_M.gguf",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sdpa"
    }
  },
  "3": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "precision": "bf16",
      "load_device": "offload_device",
      "quantization": "fp8_e4m3fn"
    }
  },
  "4": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "t5": ["3", 0],
      "model_to_offload": ["1", 0],
      "positive_prompt": "{{prompt}}",
      "negative_prompt": "{{negative_prompt}}",
      "force_offload": true,
      "device": "gpu"
    }
  },
  "5": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16"
    }
  },
  "6": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image_url}}"
    }
  },
  "8": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": ["6", 0],
      "image_1": ["7", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    }
  },
  "9": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "vae": ["5", 0],
      "start_image": ["7", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "num_frames": "{{frames}}",
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true,
      "clip_embeds": ["8", 0],
      "tiled_vae": false
    }
  },
  "10": {
    "class_type": "WanVideoLoraSelect",
    "inputs": {
      "lora": "Wan_2_2_I2V_A14B_HIGH_lightx2v_4step_lora_260412_rank_64_fp16.safetensors",
      "strength": 1.0
    }
  },
  "11": {
    "class_type": "WanVideoLoraSelect",
    "inputs": {
      "lora": "Wan_2_2_I2V_A14B_LOW_lightx2v_4step_lora_260412_rank_64_fp16.safetensors",
      "strength": 1.0
    }
  },
  "12": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["1", 0],
      "image_embeds": ["9", 0],
      "text_embeds": ["4", 0],
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "shift": 5.0,
      "seed": "{{seed}}",
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "denoise_strength": 1.0,
      "start_step": 0,
      "end_step": 3,
      "lora": ["10", 0]
    }
  },
  "13": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["2", 0],
      "image_embeds": ["9", 0],
      "text_embeds": ["4", 0],
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "shift": 5.0,
      "seed": "{{seed}}",
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "denoise_strength": 1.0,
      "start_step": 3,
      "end_step": -1,
      "samples": ["12", 0],
      "lora": ["11", 0]
    }
  },
  "14": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["5", 0],
      "samples": ["13", 0],
      "enable_vae_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "15": {
    "class_type": "SaveWEBM",
    "inputs": {
      "images": ["14", 0],
      "filename_prefix": "{{filename_prefix}}",
      "codec": "vp9",
      "fps": "{{fps}}",
      "crf": 20
    }
  }
}
