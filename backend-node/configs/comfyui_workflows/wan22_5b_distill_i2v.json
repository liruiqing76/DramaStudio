{
  "1": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model_name": "wan_fp8_scaled/TI2V/Wan2_2-TI2V-5B_fp8_e4m3fn_scaled_KJ.safetensors",
      "precision": "fp8_e4m3fn_fast",
      "attention": "disabled",
      "device": "offload_device",
      "sageattention": "sageattn"
    }
  },
  "2": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "precision": "fp8_e4m3fn",
      "device": "offload_device",
      "offload": "disabled"
    }
  },
  "3": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "t5": ["2", 0],
      "model_to_offload": ["1", 0],
      "text": "{{prompt}}",
      "negative_text": "{{negative_prompt}}",
      "force_offload": true,
      "prompt_type": false,
      "device": "gpu"
    }
  },
  "4": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wanvideo/Wan2_2_VAE_bf16.safetensors",
      "precision": "bf16"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image_url}}"
    }
  },
  "6": {
    "class_type": "WanVideoEncode",
    "inputs": {
      "vae": ["4", 0],
      "image": ["5", 0],
      "enable_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_t": 144,
      "overlap": 128,
      "crop": 0,
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "WanVideoEmptyEmbeds",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frames}}",
      "extra_latents": ["6", 0]
    }
  },
  "8": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["1", 0],
      "image_embeds": ["7", 0],
      "text_embeds": ["3", 0],
      "samples": null,
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "shift": 8,
      "sampling": "fixed",
      "eta": true,
      "sampler": "flowmatch_pusa",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["4", 0],
      "samples": ["8", 0],
      "enable_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_t": 144,
      "overlap": 128,
      "decode_type": "default"
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["9", 0],
      "fps": "{{fps}}"
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "{{filename_prefix}}",
      "video": ["10", 0],
      "format": "auto",
      "codec": "auto"
    }
  }
}
